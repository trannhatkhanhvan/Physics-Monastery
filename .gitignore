# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Ignore only video files, but keep thumbnails
/public/videos/*.mp4
/public/videos/*.mov
!/public/videos/*.jpg


# Ignore typical big binaries anywhere (sane defaults)
**/*.mxf
**/*.avi

# Keep a sandbox outside the app if you use it
/videos/

# ✅ SHIP everything under public/videos (thumbs + mp4/webm/mov, etc.)
!public/videos/
!public/videos/**

# (Optional) if you also keep images elsewhere in /public, you can still ignore non-video roots above
# but we explicitly unignore the videos folder entirely as above

