# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Ignore only video files, but keep thumbnails
/public/videos/*.mp4
/public/videos/*.mov
!/public/videos/*.jpg


# Ignore typical big binaries anywhere (sane defaults)
**/*.mxf
**/*.avi

# Keep a sandbox outside the app if you use it
/videos/

# ✅ SHIP everything under public/videos (thumbs + mp4/webm/mov, etc.)
!public/videos/
!public/videos/**

# (Optional) if you also keep images elsewhere in /public, you can still ignore non-video roots above
# but we explicitly unignore the videos folder entirely as above


# Local patch backups
*.bak*

# Mindfulness engineering study: private student data
research/mindfulness-engineering-study/data/raw/*
!research/mindfulness-engineering-study/data/raw/.gitkeep
research/mindfulness-engineering-study/data/working/*
!research/mindfulness-engineering-study/data/working/.gitkeep
research/mindfulness-engineering-study/outputs/private/*
!research/mindfulness-engineering-study/outputs/private/.gitkeep

# Avoid accidental spreadsheet commits for this study
research/mindfulness-engineering-study/**/*.xlsx
research/mindfulness-engineering-study/**/*.xls\n\n# Mindfulness engineering study: keep row-level cleaned data private for now
research/mindfulness-engineering-study/data/clean/*
!research/mindfulness-engineering-study/data/clean/.gitkeep\n
# Python cache files
__pycache__/
*.pyc
