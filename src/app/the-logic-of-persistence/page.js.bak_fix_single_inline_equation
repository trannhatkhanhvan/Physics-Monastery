function getPdfFileForChapter(chapter) {
  const explicit = {
    "front-matter": "abstract_dedication_preface.pdf",
    "chapter-01": "chapter_1.pdf",
    "chapter-02": "chapter_2.pdf",
    "chapter-03": "chapter_3.pdf",
    "chapter-04": "chapter_4.pdf",
    "chapter-05": "chapter_5.pdf",
    "chapter-06": "chapter_6.pdf",
    "chapter-07": "chapter_7.pdf",
    "chapter-08": "chapter_8.pdf",
    "chapter-09": "chapter_9.pdf",
    "chapter-10": "chapter_10.pdf",
    "chapter-11": "chapter_11.pdf",
    "chapter-12": "chapter_12.pdf",
    "epilogue": "epilogue.pdf",
    "transform-dictionary": "transform_dictionary.pdf",
    "transformation-dictionary": "transform_dictionary.pdf",
    "acknowledgements": "acknowledgments.pdf",
    "appendices": "appendices.pdf",
    "footnotes-references": "references.pdf",
  };

  if (explicit[chapter.id]) return explicit[chapter.id];

  return `${chapter.title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "_")
    .replace(/^_+|_+$/g, "")}.pdf`;
}


function InlineConnectiveActionEquation() {
  const mathStyle = {
    fontFamily: "'Times New Roman', Times, serif",
    fontStyle: "italic",
    whiteSpace: "nowrap",
  };

  const subStyle = {
    fontSize: "0.72em",
    lineHeight: 0,
    verticalAlign: "-0.25em",
  };

  const supStyle = {
    fontSize: "0.72em",
    lineHeight: 0,
    verticalAlign: "0.55em",
  };

  const nestedSubStyle = {
    fontSize: "0.72em",
    lineHeight: 0,
    verticalAlign: "-0.25em",
  };

  return (
    <span style={mathStyle}>
      A<sub style={subStyle}>k</sub>
      e
      <sup style={supStyle}>
        φ<sub style={nestedSubStyle}>k</sub>
      </sup>
      {" = "}
      n<sub style={subStyle}>k</sub>
    </span>
  );
}

function renderChapterSummary(summary) {
  const target = "Aₖe^φₖ = nₖ";

  if (!summary.includes(target)) {
    return summary;
  }

  const parts = summary.split(target);

  return (
    <>
      {parts.map((part, index) => (
        <span key={index}>
          {part}
          {index < parts.length - 1 && <InlineConnectiveActionEquation />}
        </span>
      ))}
    </>
  );
}


function ChapterPdf({ chapter }) {
  const pdfFile = getPdfFileForChapter(chapter);
  const pdfPath = `/the-logic-of-persistence/pdfs/${pdfFile}`;

  return (
    <div style={{ marginTop: "1.5rem" }}>
      <div
        style={{
          display: "flex",
          justifyContent: "space-between",
          gap: "1rem",
          alignItems: "center",
          marginBottom: "0.65rem",
        }}
      >
        <div
          style={{
            fontFamily: "Georgia, 'Times New Roman', serif",
            fontSize: "1rem",
            color: "#d8d1b8",
            letterSpacing: "0.02em",
          }}
        >
          Manuscript PDF
        </div>

        <a
          href={pdfPath}
          target="_blank"
          rel="noreferrer"
          style={{
            color: "#d8d1b8",
            fontSize: "0.9rem",
            textDecoration: "underline",
            textUnderlineOffset: "3px",
          }}
